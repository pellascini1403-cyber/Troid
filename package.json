{
  "name": "troid",
  "version": "0.1.0",
  "private": true,
  "description": "Troid \u2014 stylized 3D side-scrolling metroidvania (iOS / Android / PC). Vertical-slice foundation.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx tools/e2e/run.ts",
    "shot": "tsx tools/e2e/shot.ts",
    "bench:bundle": "tsx tools/bench/bundle.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
